{
  "name": "skycrypt-maintenance-page",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkyCryptWebsite/SkyCrypt-Maintenance-Page.git"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --check && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxfmt --check . && eslint --cache . && pnpm check",
    "format": "oxfmt",
    "gen": "wrangler types",
    "update:shadcn": "pnpm dlx shadcn-svelte@latest update -a && oxfmt --write ./src/lib/components/ui && oxfmt --write ./src/lib/shared/utils.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.59.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "bits-ui": "^2.19.5",
    "cn": "^0.5.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "oxfmt": "^0.74.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^12.14.0",
        "onFail": "download"
      }
    ],
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": "forbidden, use pnpm instead",
    "deno": "forbidden, use node instead",
    "node": "^24",
    "npm": "forbidden, use pnpm instead",
    "pnpm": "^12.14.0",
    "yarn": "forbidden, use pnpm instead"
  },
  "packageManager": "pnpm@12.14.0"
}
