{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": false,
  "trailingComma": "none",
  "bracketSameLine": true,
  "sortPackageJson": true,
  "printWidth": 120,
  "sortImports": {
    "newlinesBetween": false
  },
  "jsdoc": true,
  "sortTailwindcss": {
    "stylesheet": "src/routes/layout.css",
    "functions": ["cn"],
    "attributes": ["class", "class:*", "class:name", "/.*Classes/"],
    "preserveWhitespace": false
  },
  "svelte": {},
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "/static/",
    ".github/{agents,skills}/**",
    "worker-configuration.d.ts"
  ]
}
